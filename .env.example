# Copy to .env to override the defaults used by docker-compose.yml.
POSTGRES_USER=postoffice
POSTGRES_PASSWORD=postoffice
POSTGRES_DB=postoffice

# Used when running the API outside Docker (npm run dev in /backend).
# Port 5433 is the host port docker-compose publishes for Postgres.
DATABASE_URL=postgres://postoffice:postoffice@localhost:5433/postoffice
